# Получить на https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Сессия сохранится в файл session_name.session
SESSION_NAME=parser_session

# Ключевые слова через запятую (регистр не важен)
KEYWORDS=продажа,ищу,куплю,вакансия

# Чаты для мониторинга: @username или -100... через запятую
# Оставь пустым — будут сканироваться все диалоги
SOURCE_CHATS=@channel1,@channel2

# Группа/канал, куда отправлять найденные посты
TARGET_CHAT=@your_group

# Сохранять найденные посты в JSONL-файл
SAVE_TO_FILE=true
OUTPUT_FILE=found_posts.jsonl

# Сколько последних сообщений читать в каждом чате при старте (0 = только новые)
HISTORY_LIMIT=100

# Режим мониторинга новых сообщений в реальном времени
LISTEN_NEW=true